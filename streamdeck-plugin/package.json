        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.1",
        "@types/node": "^26.2.0",
        "@types/ws": "^8.18.1",
        "rollup": "^4.62.5",
        "tslib": "^2.8.0",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.1.2",
        "ws": "^8.21.3"
    }
}
