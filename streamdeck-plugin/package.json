{
    "name": "onair-remote-streamdeck",
    "version": "0.1.0",
    "private": true,
    "description": "Stream Deck plugin remote-controlling the onAIr teleprompter.",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.souz4rafael.onair\""
    },
