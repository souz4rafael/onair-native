<ContentDialog
    x:Class="OnAirNative.Views.Dialogs.McpToolsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MCP Tools &amp; Setup"
    PrimaryButtonText="Save"
    CloseButtonText="Close"
    DefaultButton="Primary">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="14" Padding="0,4" MinWidth="420">

            <!-- ─── What this is / how to use it ─────────────────────────── -->
            <TextBlock TextWrapping="Wrap" FontSize="13">
                onAIr includes a <Run FontWeight="SemiBold">Model Context Protocol (MCP) server</Run> —
                it lets AI assistants that support MCP (Claude Desktop, VS Code Copilot Chat, and
                others) control onAIr using natural language, e.g. "open the teleprompter and load
                my demo script". It connects to the same local Remote Control server as the Stream
                Deck plugin (the toggle on the Settings tab), so it only works while that's on and
                onAIr is running.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="13">
                <Run FontWeight="SemiBold">How to set it up:</Run>
            </TextBlock>
            <StackPanel Spacing="4" Margin="8,0,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    1. Click <Run FontWeight="SemiBold">Copy MCP Config</Run> below.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    2. Open your AI client's MCP config file:
                </TextBlock>
                <StackPanel Margin="16,0,0,0" Spacing="2">
                    <TextBlock TextWrapping="Wrap" FontSize="12">
                        • <Run FontWeight="SemiBold">Claude Desktop:</Run>
                        <Run FontFamily="Consolas">%APPDATA%\Claude\claude_desktop_config.json</Run>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12">
                        • <Run FontWeight="SemiBold">VS Code:</Run> your project's
                        <Run FontFamily="Consolas">.vscode\mcp.json</Run> (rename the outer
                        <Run FontFamily="Consolas">"mcpServers"</Run> key to
                        <Run FontFamily="Consolas">"servers"</Run>)
                    </TextBlock>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    3. Paste the copied JSON into that file — if it already has other servers
                    listed, merge it in rather than overwriting the file.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="13">
                    4. Save and <Run FontWeight="SemiBold">restart the client</Run> — onAIr's tools
                    will show up automatically.
                </TextBlock>
            </StackPanel>

            <!-- ─── Copy config ────────────────────────────────────────────── -->
            <StackPanel Spacing="8">
                <Button x:Name="CopyConfigButton"
                        Content="📋 Copy MCP Config"
                        Click="CopyConfigButton_Click"
                        ToolTipService.ToolTip="Copies a ready-to-paste JSON snippet (Claude Desktop format — adjust the key name for other clients) to the clipboard"/>
                <TextBlock x:Name="CopyStatusText"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- ─── Tool enable/disable checklist ─────────────────────────── -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="MCP TOOLS" FontWeight="Bold" FontSize="12" CharacterSpacing="40"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="Select All" FontSize="11" Padding="8,4" Click="SelectAll_Click"/>
                <Button Content="Deselect All" FontSize="11" Padding="8,4" Click="DeselectAll_Click"/>
            </StackPanel>
            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                Uncheck any tool you don't want an AI assistant to be able to call. Disabled tools
                still appear to the client but always return a "disabled" message instead of doing
                anything.
            </TextBlock>
            <StackPanel x:Name="ToolsListPanel" Spacing="10"/>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
