<Window
    x:Class="OnAirNative.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OnAirNative.Views"
    xmlns:helpers="using:OnAirNative.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="onAIr">

    <!--
        Background="Transparent" alone does not make a WinUI 3 window transparent.
        The code-behind calls WindowService.MakeTransparent(hwnd) via DWM to achieve
        true compositor transparency. The root Grid background is set to a semi-opaque
        dark brush defined in App.xaml resources.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <helpers:BoolToVisibilityConverter   x:Key="BoolToVisibilityConverter"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header bar: mode indicator + lock badge ═════════════════════ -->
        <Grid Grid.Row="0"
              x:Name="HeaderBar"
              Background="{StaticResource OverlayHeaderBgBrush}"
              Padding="8,4,8,4"
              CornerRadius="8,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Current mode label (read-only — changed from Controller) -->
            <TextBlock x:Name="CurrentModeLabel"
                       Text="● Script"
                       Foreground="#DDDDFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <!-- Lock/Unlock status -->
            <Border x:Name="MoveBadge"
                    Grid.Column="1"
                    Background="#333355"
                    CornerRadius="4"
                    Padding="6,2"
                    ToolTipService.ToolTip="Toggle locked/unlocked in the Controller">
                <TextBlock x:Name="MoveBadgeText"
                           Text="🔓 UNLOCKED"
                           FontSize="10"
                           Foreground="#AAAACC"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- ═══ Content panels (one visible at a time) ═══════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ─── Script / Teleprompter panel ─────────────────────────────── -->
            <ScrollViewer x:Name="ScriptScrollViewer"
                          Background="{StaticResource OverlayBgBrush}"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Enabled"
                          Visibility="Visible">
                <!-- Populated in code-behind, one child element per ScriptBlock (paragraph
                     line or chapter-heading divider) — see OverlayWindow.RenderScriptDocument.
                     Was a single TextBlock with a plain string; now each block gets its own
                     element so (a) bold/italic can vary per-run within a line via Inlines, and
                     (b) a chapter heading's element can be located later (TransformToVisual)
                     to compute a jump-to-chapter scroll offset. -->
                <StackPanel x:Name="ScriptBlocksPanel" Padding="0,12,0,24"/>
            </ScrollViewer>

            <!-- ─── Q&A panel ─────────────────────────────────────────────── -->
            <ScrollViewer x:Name="QaScrollViewer"
                          Background="{StaticResource OverlayBgBrush}"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Enabled"
                          Visibility="Collapsed">
              <Border x:Name="QaPanel" Padding="16,12">
                <StackPanel Spacing="10">

                    <!-- Status (recording / transcribing / getting answer) -->
                    <TextBlock x:Name="QaStatusText"
                               Foreground="#A0A0A0"
                               FontSize="13"
                               Text=""
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <!-- Live preview — rolling, still-forming transcript shown only while
                         recording with a local Whisper model loaded (see OverlayViewModel.
                         StartLivePreview). More muted than the final QaQuestionText below,
                         since it can still change on the next tick. Named "...Block" to
                         avoid reading like ViewModel.LivePreviewText in the code-behind. -->
                    <TextBlock x:Name="LivePreviewTextBlock"
                               Foreground="#70708A"
                               FontSize="13"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Text=""
                               Visibility="Collapsed"/>

                    <!-- Transcribed question (italic, subtle) -->
                    <TextBlock x:Name="QaQuestionText"
                               Foreground="#9090A0"
                               FontSize="14"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Text=""
                               Visibility="Collapsed"/>

                    <!-- AI answer (prominent) -->
                    <TextBlock x:Name="QaAnswerText"
                               Foreground="{StaticResource OverlayTextBrush}"
                               FontSize="18"
                               LineHeight="27"
                               TextWrapping="Wrap"
                               Text=""
                               Visibility="Collapsed"/>

                    <!-- Follow-up question suggestions (Block 2, opt-in via Settings) — plain,
                         non-interactive text lines (NOT buttons) built in code-behind from
                         OverlayViewModel.FollowUpSuggestions: short questions the PRESENTER
                         could ask THEIR CLIENT next, to keep the conversation flowing (a
                         sales/conversation-flow aid). Non-interactive both because the TP is
                         frequently click-through/locked during live use, and because the
                         presenter just reads/says these aloud themselves — there's nothing to
                         click. Empty/collapsed whenever there are no suggestions (feature off,
                         or none returned). -->
                    <StackPanel x:Name="FollowUpSuggestionsPanel" Spacing="4"/>

                    <!-- Busy indicator -->
                    <ProgressRing x:Name="QaBusy"
                                  IsActive="False"
                                  Width="32" Height="32"
                                  Foreground="#4A90D9"
                                  Visibility="Collapsed"/>
                </StackPanel>
              </Border>
            </ScrollViewer>

        </Grid>

        <!-- ═══ Footer: Copilot insight banner (Block 6) ═══════════════════════ -->
        <!-- A sibling of the Row 1 content Grid above (which itself hosts the two mutually-
             exclusive Script/Q&A panels) — this footer therefore stays visible regardless of
             which mode is currently showing. An external agent connected via MCP/WebSocket can
             push a short note here (see App.ShowInsightRemote / onair_show_insight) without ever
             touching the AI's own Q&A answer or the script text, so the presenter can always
             tell "what I should tell the client" apart from "a private heads-up from my
             copilot". Collapsed whenever there's no active insight — costs zero visual space
             by default, matching this app's established "TP stays uncluttered unless there's
             something worth showing" principle (see PacingSummary/glossary/knowledge-base,
             none of which ever render on the TP either). -->
        <Border Grid.Row="2"
                x:Name="InsightFooter"
                Background="{StaticResource OverlayHeaderBgBrush}"
                Padding="10,6"
                CornerRadius="0,0,8,8"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="💡" FontSize="14" VerticalAlignment="Top"/>
                <!-- Named "...Block" (not "InsightText") to avoid reading like
                     ViewModel.InsightText in the code-behind — same convention already used for
                     LivePreviewTextBlock above. -->
                <TextBlock x:Name="InsightTextBlock"
                           Foreground="#C8C8E8"
                           FontSize="12"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Text=""/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
