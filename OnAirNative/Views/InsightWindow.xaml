<Window
    x:Class="OnAirNative.Views.InsightWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AI Insights">

    <!--
        A second always-on-top transparent overlay — independent from the TP (OverlayWindow),
        built the exact same way (WindowService.MakeTransparent/SetClickThrough/etc. — see
        InsightWindow.xaml.cs), but its own window. That means it can be freely dragged, resized
        and shown/hidden without ever touching the TP, and both can be open side by side at the
        same time. Hosts ONLY the Copilot-insight text an external MCP agent pushes (see
        App.ShowInsightRemote / onair_show_insight) — nothing else lives here, so there's never
        ambiguity between "what I should tell the client" (the TP/Q&A answer) and "a private
        heads-up from my copilot" (this window).
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header bar: title + lock badge (draggable region) ═══════════ -->
        <Grid Grid.Row="0"
              x:Name="HeaderBar"
              Background="{StaticResource OverlayHeaderBgBrush}"
              Padding="8,4,8,4"
              CornerRadius="8,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="💡 AI Insights"
                       Foreground="#DDDDFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <Border x:Name="MoveBadge"
                    Grid.Column="1"
                    Background="#333355"
                    CornerRadius="4"
                    Padding="6,2"
                    ToolTipService.ToolTip="Toggle locked/unlocked from the Controller">
                <TextBlock x:Name="MoveBadgeText"
                           Text="🔓 UNLOCKED"
                           FontSize="10"
                           Foreground="#AAAACC"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- ═══ Content: the insight text, at full readable size and scrollable ═ -->
        <ScrollViewer Grid.Row="1"
                      Background="{StaticResource OverlayBgBrush}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Enabled">
            <TextBlock x:Name="InsightTextBlock"
                       Foreground="#F0F0F0"
                       FontSize="16"
                       LineHeight="24"
                       TextWrapping="Wrap"
                       Padding="16,12"
                       Text="No insights yet"/>
        </ScrollViewer>
    </Grid>
</Window>
