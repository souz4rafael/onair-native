<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Target Windows 10 2004 (19041) minimum — required for WinUI 3 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OnAirNative</RootNamespace>
    <AssemblyName>OnAirNative</AssemblyName>
    <!-- Explicit product version so the installed exe's ProductVersion (visible via
         Get-Item .VersionInfo.ProductVersion) reflects the actual release number instead of
         defaulting to 1.0.0+<git-sha>. Keep in sync with AboutTabViewModel.Version and
         installer\onair-native.nsi's PRODUCT_VERSION on every release. -->
    <Version>1.3.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds the icon into OnAirNative.exe (Explorer, shortcuts, Alt-Tab default).
         The windows also call AppWindow.SetIcon at runtime (see WindowService.SetWindowIcon)
         since an unpackaged WinUI 3 window does not pick up the exe icon on its own. -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <!-- Force x64 as the resolved $(Platform) even when a build doesn't go through the
         .sln / doesn't pass -p:Platform=x64 explicitly (e.g. `dotnet build` run directly
         against this .csproj, or Visual Studio with "Any CPU" left selected in the
         Solution Platform dropdown). Without this, MSBuild's default $(Platform) is
         "AnyCPU", which — since AnyCPU != x64 — writes to a completely different,
         un-synced output folder (bin\Debug\... instead of bin\x64\Debug\...). That stale
         copy silently stops receiving new builds while still being a runnable exe, which
         is exactly the kind of "I tested it and nothing changed" trap this prevents. -->
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged deployment — no MSIX required -->
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      Deploy the Windows App SDK app-local instead of depending on the machine-wide
      "Microsoft.WindowsAppRuntime.2" MSIX framework package.

      Why: framework-dependent WinUI 3 needs that package registered *for the user
      running the app*. On managed/corporate machines the elevated installer either
      registers it for the admin account that approved UAC (not the logged-on user),
      or sideloading is blocked by policy outright. Either way the bootstrapper fails
      and the app dies with a XamlParseException before showing a window — the exact
      "installs fine, never opens" symptom. Self-contained removes the dependency.
    -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <!-- Suppress the auto-generated XAML break-on-exception which fires in debug.
         DISABLE_XAML_GENERATED_MAIN: we provide our own Main (Program.cs) so we
         can do single-instance redirection before the app starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION;DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!--
      Normalize source paths embedded in the binary/PDB so crash stack traces
      don't leak the build machine's username and folder layout. Real paths
      (C:\Users\...\OnAirNative\) become /src\... in shipped stack traces.
    -->
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon — copied to output folder so TrayService can load it at runtime -->
    <Content Include="Assets\app-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Packaged Stream Deck plugin (built from ..\streamdeck-plugin via `streamdeck pack`) —
         bundled so the Settings tab's "Install Stream Deck Plugin" button can hand it off to
         the Stream Deck app without requiring Node.js/npm on the end user's machine. Rebuild
         with `streamdeck pack com.souz4rafael.onair.sdPlugin -o dist -f` from streamdeck-plugin\
         after any plugin change, then copy the output here as onair-remote.streamDeckPlugin. -->
    <Content Include="Assets\onair-remote.streamDeckPlugin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Packaged onAIr MCP server (built from ..\mcp-server via dotnet publish -c Release) —
         bundled so Settings tab's "MCP Tools & Setup…" dialog can always show a real, working
         absolute path to register with an MCP client (Claude Desktop, VS Code Copilot Chat,
         etc.), regardless of whether this is a dev build or an installed copy. Framework
         dependent publish (not self-contained) — fine since onAIr itself already requires the
         .NET 8 x64 runtime to run at all. Rebuild via: dotnet publish -c Release -o publish
         (self contained false) from mcp-server\, then copy publish\* here (minus the .pdb —
         not needed at runtime) after any mcp-server change. -->
    <Content Include="Assets\mcp-server\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Windows App SDK — provides WinUI 3, AppWindow, WebView2, etc. -->
    <!-- Run: dotnet add package Microsoft.WindowsAppSDK -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <!-- Windows SDK build tools (required by WinUI 3 codegen) -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" PrivateAssets="all" />

    <!-- MVVM source generators: [ObservableProperty], [RelayCommand] -->
    <!-- Run: dotnet add package CommunityToolkit.Mvvm -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- NAudio: WASAPI microphone capture + loopback (system audio) -->
    <!-- Run: dotnet add package NAudio -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- Whisper.net: in-process Whisper transcription (no Python subprocess) -->
    <!-- Run: dotnet add package Whisper.net && dotnet add package Whisper.net.Runtime -->
    <PackageReference Include="Whisper.net" Version="1.7.3" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.3" />

    <!-- Enumerates fonts actually installed on the user's PC for the Appearance font-family
         picker (System.Drawing.Text.InstalledFontCollection). Windows-only API — safe here
         since the TFM is already net8.0-windows10.0.19041.0 (no CA1416 warnings). -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure, WinUI-free logic (script parsing, config load/save, AI provider routing,
         update-check version comparison) — extracted here specifically so
         OnAirNative.Tests can unit-test it directly without dragging the full WinUI/MSIX
         PRI-generation build tooling into a plain test project (that combination doesn't
         build outside a full WinUI/UWP SDK install). Brings System.Security.Cryptography.
         ProtectedData transitively (was a direct PackageReference here before the move). -->
    <ProjectReference Include="..\OnAirNative.Core\OnAirNative.Core.csproj" />
  </ItemGroup>

  <!--
    Visual C++ Runtime — app-local deployment.
    WinUI 3 / Windows App SDK self-contained does NOT bundle the VC++ Runtime,
    so on a clean machine without the VC++ Redistributable the native WinUI
    components fail to load and the app exits silently with no error.
    Copying these redistributable DLLs next to the exe makes the app truly
    self-contained. Source: the VC Tools redist dir when a VS build env is
    present, otherwise the system copy.
  -->
  <Target Name="CopyVCRuntime" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_VCRedistX64>$(VCToolsRedistDir)x64\Microsoft.VC143.CRT\</_VCRedistX64>
      <!-- OpenMP runtime ships in a separate redist subfolder from the CRT -->
      <_VCOpenMPRedistX64>$(VCToolsRedistDir)x64\Microsoft.VC143.OpenMP\</_VCOpenMPRedistX64>
    </PropertyGroup>
    <ItemGroup>
      <!-- msvcp140_1/_2/_atomic_wait and concrt140 are pulled in by the self-contained
           Windows App SDK native DLLs and by whisper.dll; shipping only the base three
           still leaves a missing-DLL failure on machines without the redistributable. -->
      <_VCRuntimeNames Include="vcruntime140.dll;vcruntime140_1.dll;msvcp140.dll;msvcp140_1.dll;msvcp140_2.dll;msvcp140_atomic_wait.dll;msvcp140_codecvt_ids.dll;concrt140.dll" />
      <_VCRuntimeFiles Condition="Exists('$(_VCRedistX64)%(_VCRuntimeNames.Identity)')" Include="$(_VCRedistX64)%(_VCRuntimeNames.Identity)" />
      <_VCRuntimeFiles Condition="!Exists('$(_VCRedistX64)%(_VCRuntimeNames.Identity)') and Exists('$(WINDIR)\System32\%(_VCRuntimeNames.Identity)')" Include="$(WINDIR)\System32\%(_VCRuntimeNames.Identity)" />

      <!-- vcomp140.dll (OpenMP) is a confirmed static import of ggml-whisper.dll
           (whisper.net's native inference engine uses OpenMP for parallel matrix
           ops) — verified via PE import-table analysis. Without it, Whisper
           transcription fails to load on a machine without the VC++ Redistributable,
           even though the rest of the app runs fine. -->
      <_VCOpenMPNames Include="vcomp140.dll" />
      <_VCRuntimeFiles Condition="Exists('$(_VCOpenMPRedistX64)%(_VCOpenMPNames.Identity)')" Include="$(_VCOpenMPRedistX64)%(_VCOpenMPNames.Identity)" />
      <_VCRuntimeFiles Condition="!Exists('$(_VCOpenMPRedistX64)%(_VCOpenMPNames.Identity)') and Exists('$(WINDIR)\System32\%(_VCOpenMPNames.Identity)')" Include="$(WINDIR)\System32\%(_VCOpenMPNames.Identity)" />
    </ItemGroup>
    <Copy SourceFiles="@(_VCRuntimeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(_VCRuntimeFiles)' != ''" />
    <Copy SourceFiles="@(_VCRuntimeFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and '@(_VCRuntimeFiles)' != ''" />
  </Target>

  <!--
    Deploy the compiled XAML resource index (OnAirNative.pri) to the publish
    folder. `dotnet publish` to a custom output directory does NOT copy the
    PRI file, so at runtime LoadComponent cannot find the compiled .xbf XAML
    and every Window() throws XamlParseException — the app installs fine but
    exits silently / crashes on launch. Copy the build-produced PRI into the
    publish output to fix this.
  -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
  </Target>

</Project>
