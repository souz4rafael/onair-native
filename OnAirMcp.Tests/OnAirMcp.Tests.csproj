<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net8.0, matching OnAirMcp.csproj itself — ToolGate has no Windows-specific
         dependency (just File I/O + JSON), so this stays cross-platform like the server. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- ToolGate.IsDisabled only — OnAirClient's request/response correlation logic is
         deliberately out of scope (hardcoded singleton bound to a fixed real port; better
         covered by the planned end-to-end integration-test suite than a forced unit test). -->
    <ProjectReference Include="..\mcp-server\OnAirMcp.csproj" />
  </ItemGroup>

</Project>
